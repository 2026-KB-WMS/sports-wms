<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Product Page</title>
    <style>
        .form-group { margin-bottom: 10px; }
        .spec-group { margin-bottom: 12px; }
        .spec-group strong { display: block; margin-bottom: 4px; }
        .error { color: red; font-size: 0.9em; }
        section { margin-bottom: 40px; }
        #specPlaceholder { color: #888; font-size: 0.9em; }
    </style>
</head>
<body>
<h1>상품 마스터 관리</h1>
<hr>

{{! 브랜드 등록 }}
<section>
    <h2>브랜드 등록</h2>
    {{#brandError}}<p class="error">{{brandError}}</p>{{/brandError}}
    <form action="/product/brand" method="post">
        <div class="form-group">
            <label for="brandName">브랜드명:</label>
            <input type="text" id="brandName" name="name" placeholder="예) Yonex" required>
        </div>
        <div class="form-group">
            <label for="brandCode">브랜드 코드:</label>
            <input type="text" id="brandCode" name="code" placeholder="예) YNX" required>
        </div>
        <button type="submit">브랜드 등록</button>
    </form>
</section>

<hr>

{{! 상품 등록 }}
<section>
    <h2>상품 등록</h2>
    {{#productError}}<p class="error">{{productError}}</p>{{/productError}}
    <form action="/product" method="post" id="productForm">
        <div class="form-group">
            <label for="productName">상품명:</label>
            <input type="text" id="productName" name="name" placeholder="예) Astrox 99" required>
        </div>
        <div class="form-group">
            <label for="productCode">상품 코드:</label>
            <input type="text" id="productCode" name="code" placeholder="예) AX99" required>
        </div>
        <div class="form-group">
            <label for="price">가격:</label>
            <input type="number" id="price" name="price" placeholder="최소 1000원" min="1000" required>
        </div>
        <div class="form-group">
            <label for="brandId">브랜드:</label>
            <select id="brandId" name="brandId" required>
                <option value="">브랜드 선택</option>
                {{#brands}}
                    <option value="{{id}}">{{name}}</option>
                {{/brands}}
            </select>
        </div>
        <div class="form-group">
            <label for="categoryId">카테고리:</label>
            <select id="categoryId" name="categoryId" required>
                <option value="">카테고리 선택</option>
                {{#categories}}
                    <option value="{{id}}">{{name}}</option>
                {{/categories}}
            </select>
        </div>

        <div class="form-group">
            <label>고정 스펙:</label>
            <div id="specArea">
                <p id="specPlaceholder">카테고리를 선택하면 스펙 항목이 표시됩니다.</p>
            </div>
        </div>

        <button type="submit">상품 등록</button>
    </form>
</section>

<hr>

{{! 등록된 브랜드 목록 }}
<section>
    <h2>등록된 브랜드 목록</h2>
    <table border="1" cellpadding="5" cellspacing="0">
        <thead>
        <tr>
            <th>브랜드 ID</th>
            <th>브랜드명</th>
            <th>브랜드 코드</th>
        </tr>
        </thead>
        <tbody>
        {{#brands}}
            <tr><td>{{id}}</td><td>{{name}}</td><td>{{code}}</td></tr>
        {{/brands}}
        {{^brands}}
            <tr><td colspan="3" style="text-align:center;">등록된 브랜드가 없습니다.</td></tr>
        {{/brands}}
        </tbody>
    </table>
</section>

<hr>

{{! 등록된 상품 목록 }}
<section>
    <h2>등록된 상품 목록</h2>
    <table border="1" cellpadding="5" cellspacing="0">
        <thead>
        <tr>
            <th>상품 ID</th>
            <th>카테고리</th>
            <th>브랜드</th>
            <th>상품명</th>
            <th>상품 코드</th>
            <th>가격</th>
        </tr>
        </thead>
        <tbody>
        {{#products}}
            <tr>
                <td>{{id}}</td>
                <td>{{category.name}}</td>
                <td>{{brand.name}}</td>
                <td>{{name}}</td>
                <td>{{code}}</td>
                <td>{{price}}원</td>
            </tr>
        {{/products}}
        {{^products}}
            <tr><td colspan="6" style="text-align:center;">등록된 상품이 없습니다.</td></tr>
        {{/products}}
        </tbody>
    </table>
</section>

<script>
    const categorySelect = document.getElementById('categoryId');
    const specArea       = document.getElementById('specArea');

    categorySelect.addEventListener('change', function () {
        const categoryId = this.value;
        specArea.innerHTML = '';

        if (!categoryId) {
            specArea.innerHTML = '<p id="specPlaceholder" style="color:#888;font-size:0.9em;">카테고리를 선택하면 스펙 항목이 표시됩니다.</p>';
            return;
        }

        fetch('/api/categories/' + categoryId + '/spec-option-groups')
            .then(res => res.json())
            .then(groups => {
                if (groups.length === 0) {
                    specArea.innerHTML = '<p style="color:#888;font-size:0.9em;">이 카테고리에 고정 스펙이 없습니다.</p>';
                    return;
                }

                groups.forEach(group => {
                    const div = document.createElement('div');
                    div.className = 'spec-group';

                    const label = document.createElement('strong');
                    label.textContent = group.name + ' (필수)';
                    div.appendChild(label);

                    group.optionValues.forEach(value => {
                        const valueLabel = document.createElement('label');
                        valueLabel.style.marginRight = '12px';

                        const radio = document.createElement('input');
                        radio.type  = 'radio';
                        radio.name  = 'spec_group_' + group.id;  // 그룹별 단일 선택
                        radio.value = value.id;
                        radio.dataset.groupId = group.id;
                        radio.addEventListener('change', syncSpecHiddenInputs);

                        valueLabel.appendChild(radio);
                        valueLabel.appendChild(document.createTextNode(' ' + value.name));
                        div.appendChild(valueLabel);
                    });

                    specArea.appendChild(div);
                });

                const hiddenContainer = document.createElement('div');
                hiddenContainer.id = 'specHiddenContainer';
                specArea.appendChild(hiddenContainer);
            })
            .catch(() => {
                specArea.innerHTML = '<p class="error">스펙 정보를 불러오지 못했습니다.</p>';
            });
    });

    function syncSpecHiddenInputs() {
        const container = document.getElementById('specHiddenContainer');
        container.innerHTML = '';
        document.querySelectorAll('input[type=radio][data-group-id]:checked').forEach(radio => {
            const hidden = document.createElement('input');
            hidden.type  = 'hidden';
            hidden.name  = 'specOptionValueIds';
            hidden.value = radio.value;
            container.appendChild(hidden);
        });
    }
</script>

</body>
</html>
