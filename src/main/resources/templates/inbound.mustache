<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>입고 관리</title>
    <style>
        body { font-family: sans-serif; }
        .container { display: flex; gap: 40px; }
        .form-section, .list-section { width: 50%; }
        form { border: 1px solid #ccc; padding: 15px; border-radius: 5px; }
        .form-group { margin-bottom: 10px; }
        label { display: block; margin-bottom: 5px; }
        input, select { width: 100%; padding: 8px; box-sizing: border-box; }
        .item-row { display: flex; gap: 10px; align-items: center; margin-bottom: 10px; }
        .item-row select { flex: 3; }
        .item-row input { flex: 1; }
        .item-row button { flex: 0.5; padding: 8px; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background-color: #f2f2f2; }
        .error { color: red; font-size: 0.9em; margin-top: 5px; }
    </style>
</head>
<body>

<h1>입고 관리</h1>

<div class="container">
    {{#isWarehouseManager}}
    <div class="form-section">
        <h2>신규 입고 요청</h2>
        <form action="/inbound" method="post" id="inbound-form" onsubmit="return validateNoDuplicateSku()">
            <div class="form-group">
                <label for="warehouseId">창고 선택</label>
                <select id="warehouseId" name="warehouseId" required>
                    <option value="">-- 창고를 선택하세요 --</option>
                    {{#warehouses}}
                        <option value="{{id}}">{{name}}</option>
                    {{/warehouses}}
                </select>
            </div>

            <hr>
            <h4>입고 품목</h4>
            <div id="items-container">
                <!-- 아이템 행이 여기에 동적으로 추가됩니다. -->
            </div>
            <button type="button" onclick="addItemRow()">품목 추가</button>
            <p id="duplicate-error" class="error" style="display:none;">동일한 상품(SKU)을 중복해서 선택할 수 없습니다.</p>
            <hr>

            <button type="submit">입고 요청 생성</button>
            {{#errorMessage}}
                <p class="error">{{errorMessage}}</p>
            {{/errorMessage}}
        </form>
    </div>
    {{/isWarehouseManager}}
    <div class="list-section">
        <h2>입고 요청 내역</h2>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>창고</th>
                    <th>요청 시간</th>
                    <th>상태</th>
                    <th>상세</th>
                </tr>
            </thead>
            <tbody>
                {{#inbounds}}
                <tr>
                    <td>{{id}}</td>
                    <td>{{warehouse.name}}</td>
                    <td>{{requestTime}}</td>
                    <td>{{status.description}}</td>
                    <td><a href="/inbound/{{id}}">보기</a></td>
                </tr>
                {{/inbounds}}
                {{^inbounds}}
                <tr>
                    <td colspan="5" style="text-align: center;">입고 내역이 없습니다.</td>
                </tr>
                {{/inbounds}}
            </tbody>
        </table>
    </div>
</div>

<script>
    let itemIndex = 0;

    function addItemRow() {
        const container = document.getElementById('items-container');
        const itemRow = document.createElement('div');
        itemRow.classList.add('item-row');
        itemRow.setAttribute('id', 'item-row-' + itemIndex);

        let skuOptions = '{{#skus}}<option value="{{id}}">{{name}} ({{product.name}})</option>{{/skus}}';

        itemRow.innerHTML = `
            <select name="items[${itemIndex}].skuId" class="sku-select" onchange="clearDuplicateError()">
                <option value="">-- 품목(SKU)을 선택하세요 --</option>
                ${skuOptions}
            </select>
            <input type="number" name="items[${itemIndex}].quantity" placeholder="수량">
            <button type="button" onclick="removeItemRow(${itemIndex})">삭제</button>
        `;

        container.appendChild(itemRow);
        itemIndex++;
    }

    function removeItemRow(index) {
        const itemRow = document.getElementById('item-row-' + index);
        if (itemRow) {
            itemRow.remove();
        }
    }

    function clearDuplicateError() {
        document.getElementById('duplicate-error').style.display = 'none';
    }

    // 폼 제출 시 동일한 SKU가 중복 선택되지 않았는지 검증
    // 비어있는 선택은 서버의 @NotNull 검증이 별도로 처리
    function validateNoDuplicateSku() {
        const selects = document.querySelectorAll('#items-container .sku-select');
        const selectedSkuIds = Array.from(selects)
            .map(select => select.value)
            .filter(value => value !== '');

        const hasDuplicate = new Set(selectedSkuIds).size !== selectedSkuIds.length;

        if (hasDuplicate) {
            document.getElementById('duplicate-error').style.display = 'block';
            return false;
        }

        clearDuplicateError();
        return true;
    }

    // 페이지 로드 시 기본으로 하나의 품목 행을 추가
    window.onload = function() {
        addItemRow();
    };
</script>

</body>
</html>
