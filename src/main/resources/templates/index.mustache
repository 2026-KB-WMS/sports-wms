<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Document</title>
</head>
<body>
<h1>index page</h1>
<hr>

{{#loginId}}
    <p>name : <strong>{{loginId}} </strong></p>

    {{#isGeneralManager}}
        <!-- 본사 관리자 메뉴 -->
        <button onclick="location.href='/order'">발주 요청 조회</button>
        <button onclick="location.href='/sku'">SKU 조회/등록</button>
        <button onclick="location.href='/inbound'">입고 관리</button>
        <button onclick="location.href='/outbound'">출고 관리</button>
        <button onclick="location.href='/warehouse'">창고 조회</button>
        <button onclick="location.href='/inventory'">재고 조회</button>
        <button onclick="location.href='/store'">지점 조회</button>
    {{/isGeneralManager}}

    {{#isWarehouseManager}}
        <!-- 창고 관리자 메뉴 -->
        <button onclick="location.href='/order/warehouse-orders'">발주 요청 조회</button>
        <button onclick="location.href='/inbound'">입고 관리</button>
        <button onclick="location.href='/outbound'">출고 관리</button>
        <button onclick="location.href='/inventory'">재고 조회</button>
    {{/isWarehouseManager}}

    {{#isUser}}
        <!-- 지점 점주/매니저 메뉴 -->
        <button onclick="location.href='/order'">발주 등록 및 내역 조회</button>
        <button onclick="location.href='/inventory'">지점 재고 조회</button>
    {{/isUser}}

    <br><br>
    <form action="/logout" method="post" style="display: inline;">
        <button type="submit">로그아웃</button>
    </form>
{{/loginId}}

{{^loginId}}
    <button onclick="location.href='/login'">로그인</button>
    <button onclick="location.href='/signup'">회원가입</button>
{{/loginId}}

</body>
</html>
