<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>SKU Page</title>
    <style>
        .form-group { margin-bottom: 10px; }
        .option-group { margin-bottom: 12px; }
        .option-group strong { display: block; margin-bottom: 4px; }
        .error { color: red; font-size: 0.9em; }
        #optionArea { margin-top: 8px; }
        #optionPlaceholder { color: #888; font-size: 0.9em; }
    </style>
</head>
<body>
<h1>SKU Management</h1>
<hr>

<h2>SKU 등록</h2>

{{#skuError}}
    <p class="error">{{skuError}}</p>
{{/skuError}}

<form action="/sku" method="post" id="skuForm">
    <div class="form-group">
        <label for="productId">상품명:</label>
        <select id="productId" name="productId" required>
            <option value="">상품 선택</option>
            {{#products}}
                <option value="{{id}}">{{name}}</option>
            {{/products}}
        </select>
    </div>

    <div class="form-group">
        <label>옵션 선택:</label>
        <div id="optionArea">
            <p id="optionPlaceholder">상품을 먼저 선택하면 옵션이 표시됩니다.</p>
        </div>
    </div>

    <button type="submit" id="submitBtn" disabled>등록</button>
</form>

<hr>

<h2>등록된 SKU 목록</h2>
<table border="1" cellpadding="5" cellspacing="0">
    <thead>
    <tr>
        <th>카테고리</th>
        <th>브랜드</th>
        <th>상품명</th>
        <th>SKU 명</th>
        <th>SKU 코드</th>
        <th>옵션</th>
        <th>시스템 등록 가격</th>
    </tr>
    </thead>
    <tbody>
    {{#skus}}
        <tr>
            <td>{{product.category.name}}</td>
            <td>{{product.brand.name}}</td>
            <td>{{product.name}}</td>
            <td>{{name}}</td>
            <td><strong>{{skuCode}}</strong></td>
            <td>
                {{#optionSKUMappings}}
                    [{{optionValue.optionGroup.name}} : {{optionValue.name}}]<br>
                {{/optionSKUMappings}}
            </td>
            <td>{{product.price}}원</td>
        </tr>
    {{/skus}}
    {{^skus}}
        <tr>
            <td colspan="7" style="text-align: center;">현재 시스템에 등록된 물류 SKU 마스터 데이터가 없습니다.</td>
        </tr>
    {{/skus}}
    </tbody>
</table>

<script>
    const productSelect = document.getElementById('productId');
    const optionArea    = document.getElementById('optionArea');
    const submitBtn     = document.getElementById('submitBtn');

    productSelect.addEventListener('change', function () {
        const productId = this.value;
        optionArea.innerHTML = '';
        submitBtn.disabled = true;

        if (!productId) {
            optionArea.innerHTML = '<p id="optionPlaceholder" style="color:#888;font-size:0.9em;">상품을 먼저 선택하면 옵션이 표시됩니다.</p>';
            return;
        }

        fetch('/api/products/' + productId + '/option-groups')
            .then(res => res.json())
            .then(groups => {
                if (groups.length === 0) {
                    optionArea.innerHTML = '<p style="color:#888;font-size:0.9em;">이 상품에 설정된 옵션이 없습니다.</p>';
                    submitBtn.disabled = false;
                    return;
                }

                groups.forEach(group => {
                    const div = document.createElement('div');
                    div.className = 'option-group';

                    const label = document.createElement('strong');
                    label.textContent = group.name + ' (필수)';
                    div.appendChild(label);

                    group.optionValues.forEach(value => {
                        const valueLabel = document.createElement('label');
                        valueLabel.style.marginRight = '12px';

                        const radio = document.createElement('input');
                        radio.type  = 'radio';
                        // 그룹별로 name을 분리해서 각 그룹 내에서만 단일 선택되도록 함
                        radio.name  = 'group_' + group.id;
                        radio.value = value.id;
                        radio.dataset.groupId = group.id;
                        radio.addEventListener('change', syncHiddenInputs);

                        valueLabel.appendChild(radio);
                        valueLabel.appendChild(document.createTextNode(' ' + value.name));
                        div.appendChild(valueLabel);
                    });

                    optionArea.appendChild(div);
                });

                // 그룹별 hidden input 컨테이너
                const hiddenContainer = document.createElement('div');
                hiddenContainer.id = 'hiddenContainer';
                optionArea.appendChild(hiddenContainer);

                updateSubmitState(groups.length);
            })
            .catch(() => {
                optionArea.innerHTML = '<p class="error">옵션 정보를 불러오지 못했습니다.</p>';
            });
    });

    function syncHiddenInputs() {
        const hiddenContainer = document.getElementById('hiddenContainer');
        hiddenContainer.innerHTML = '';

        // 선택된 라디오들을 hidden input으로 변환 (name="optionValueIds" 배열로 전송)
        document.querySelectorAll('input[type=radio][data-group-id]:checked').forEach(radio => {
            const hidden = document.createElement('input');
            hidden.type  = 'hidden';
            hidden.name  = 'optionValueIds';
            hidden.value = radio.value;
            hiddenContainer.appendChild(hidden);
        });

        // 모든 그룹에서 선택이 됐는지 확인해서 버튼 활성화
        const totalGroups   = document.querySelectorAll('.option-group').length;
        const checkedGroups = document.querySelectorAll('input[type=radio][data-group-id]:checked').length;
        submitBtn.disabled  = checkedGroups < totalGroups;
    }

    function updateSubmitState(totalGroups) {
        const checkedGroups = document.querySelectorAll('input[type=radio][data-group-id]:checked').length;
        submitBtn.disabled  = checkedGroups < totalGroups;
    }
</script>

</body>
</html>
