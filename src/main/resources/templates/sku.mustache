<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>SKU Page</title>
    <style>
        .form-group { margin-bottom: 10px; }
        .error { color: red; font-size: 0.9em; }
        .option-group { margin-bottom: 5px; }
    </style>
</head>
<body>
<h1>SKU Management</h1>
<hr>

<h2>신규 상품 및 SKU 등록</h2>
<form action="/sku" method="post">
    <div class="form-group">
        <label for="productId">상품명:</label>
        <select id="productId" name="productId" required>
            <option value="">상품 선택</option>
            {{#products}}
                <option value="{{id}}">{{name}}</option>
            {{/products}}
        </select>
    </div>
    <div class="form-group">
        <label>옵션 선택 (최소 1개 이상):</label><br>
        {{#optionGroups}}
            <div class="option-group">
                <strong>{{name}}:</strong>
                {{#optionValues}}
                    <label>
                        <input type="checkbox" name="optionValueIds" value="{{id}}">
                        {{name}}
                    </label>
                {{/optionValues}}
            </div>
        {{/optionGroups}}
    </div>

    <button type="submit">등록</button>
</form>

<hr>

<h2>등록된 SKU 목록</h2>
<table border="1" cellpadding="5" cellspacing="0">
    <thead>
    <tr>
        <th>카테고리</th>
        <th>브랜드</th>
        <th>상품명</th>
        <th>SKU 명</th>
        <th>SKU 코드</th>
        <th>옵션</th>
        <th>시스템 등록 가격</th>
    </tr>
    </thead>
    <tbody>
    {{#skus}}
        <tr>
            <td>{{product.category.name}}</td>
            <td>{{product.brand.name}}</td>
            <td>{{product.name}}</td>
            <td>{{name}}</td>
            <td><strong>{{skuCode}}</strong></td>
            <td>
                {{#optionSKUMappings}}
                    [{{optionValue.optionGroup.name}} : {{optionValue.name}}]<br>
                {{/optionSKUMappings}}
            </td>
            <td>{{product.price}}원</td>
        </tr>
    {{/skus}}

    {{^skus}}
        <tr>
            <td colspan="7" style="text-align: center;">현재 시스템에 등록된 물류 SKU 마스터 데이터가 없습니다.</td>
        </tr>
    {{/skus}}
    </tbody>
</table>

</body>
</html>
