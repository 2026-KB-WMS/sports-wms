<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Warehouse Management</title>
    <style>
        body { font-family: sans-serif; }
        .container { display: flex; gap: 40px; }
        .warehouse-list, .forms { width: 50%; }
        .forms form { border: 1px solid #ccc; border-radius: 5px; padding: 15px; margin-bottom: 20px; }
        .form-group { margin-bottom: 10px; }
        .form-group label { display: block; margin-bottom: 5px; }
        .form-group input, .form-group select { width: 100%; padding: 8px; box-sizing: border-box; }
        .form-group.address-group { display: flex; gap: 10px; align-items: center; }
        .form-group.address-group input[name="postcode"] { width: 100px; }
        .form-group.address-group button { padding: 8px 12px; }
        .error { color: red; font-size: 0.9em; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; margin-bottom: 20px;}
        th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
    </style>
</head>
<body>

<h1>창고/구역 관리</h1>
<hr>

<div class="container">
    <div class="warehouse-list">
        <h2>창고 목록</h2>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>창고명</th>
                    <th>주소</th>
                    <th>최대 수용량</th>
                    <th>현재 수용량</th>
                </tr>
            </thead>
            <tbody>
                {{#warehouses}}
                    <tr>
                        <td>{{id}}</td>
                        <td>{{name}}</td>
                        <td>{{address}}</td>
                        <td>{{totalCapacity}}</td>
                        <td>{{currentSectionCapacity}}</td>
                    </tr>
                {{/warehouses}}
                {{^warehouses}}
                    <tr>
                        <td colspan="5" style="text-align: center;">등록된 창고가 없습니다.</td>
                    </tr>
                {{/warehouses}}
            </tbody>
        </table>

        <h2>구역 목록</h2>
        <table>
            <thead>
                <tr>
                    <th>소속 창고</th>
                    <th>구역명</th>
                    <th>구역 코드</th>
                    <th>구역 타입</th>
                    <th>최대 수용량</th>
                </tr>
            </thead>
            <tbody>
                {{#sections}}
                    <tr>
                        <td>{{warehouse.name}}</td>
                        <td>{{name}}</td>
                        <td>{{sectionCode}}</td>
                        <td>{{sectionType.title}}</td>
                        <td>{{totalCapacity}}</td>
                    </tr>
                {{/sections}}
                {{^sections}}
                    <tr>
                        <td colspan="5" style="text-align: center;">등록된 구역이 없습니다.</td>
                    </tr>
                {{/sections}}
            </tbody>
        </table>

        <h2>창고 담당자 배정 현황</h2>
        <table>
            <thead>
                <tr>
                    <th>창고명</th>
                    <th>담당자 ID</th>
                    <th>담당자 이름</th>
                    <th>권한</th>
                </tr>
            </thead>
            <tbody>
                {{#warehouseManagements}}
                    <tr>
                        <td>{{warehouse.name}}</td>
                        <td>{{user.loginId}}</td>
                        <td>{{user.name}}</td>
                        <td>{{managementType.roleName}}</td>
                    </tr>
                {{/warehouseManagements}}
                {{^warehouseManagements}}
                    <tr>
                        <td colspan="4" style="text-align: center;">배정된 담당자가 없습니다.</td>
                    </tr>
                {{/warehouseManagements}}
            </tbody>
        </table>
    </div>

    <div class="forms">
        <h2>신규 창고 등록</h2>
        <form action="/warehouse" method="post">
            <div class="form-group">
                <label for="warehouseName">창고명:</label>
                <input type="text" id="warehouseName" name="name" value="{{warehouseCreateRequestDTO.name}}" required>
            </div>
            <div class="form-group address-group">
                <input type="text" name="postcode" placeholder="우편번호" value="{{warehouseCreateRequestDTO.postcode}}" readonly>
                <button type="button" onclick="openDaumPostcode()">주소 검색</button>
            </div>
            <div class="form-group">
                <input type="text" name="address" placeholder="주소" value="{{warehouseCreateRequestDTO.address}}" readonly required>
            </div>
            <div class="form-group">
                <input type="text" name="detailAddress" placeholder="상세주소" value="{{warehouseCreateRequestDTO.detailAddress}}">
            </div>
            <div class="form-group">
                <input type="text" name="totalCapacity" placeholder="최대 수용량" value="{{warehouseCreateRequestDTO.totalCapacity}}" min="1000" required>
            </div>
            <button type="submit">창고 등록</button>
        </form>
        {{#warehouseCreateError}}
            {{warehouseCreateError}}
        {{/warehouseCreateError}}

        <h2>신규 구역 등록</h2>
        <form action="/warehouse/section" method="post">
            <div class="form-group">
                <label for="warehouseId">소속 창고:</label>
                <select id="warehouseId" name="warehouseId" required>
                    <option value="">창고 선택</option>
                    {{#warehouses}}
                        <option value="{{id}}">{{name}}</option>
                    {{/warehouses}}
                </select>
            </div>
            <div class="form-group">
                <label for="sectionName">구역명:</label>
                <input type="text" id="sectionName" name="name" value="{{sectionCreateRequestDTO.name}}" required>
            </div>
            <div class="form-group">
                <label for="sectionCode">구역 코드:</label>
                <input type="text" id="sectionCode" name="sectionCode" value="{{sectionCreateRequestDTO.sectionCode}}" required>
            </div>
            <div class="form-group">
                <label for="sectionType">구역 타입:</label>
                <select id="sectionType" name="sectionType" required>
                    <option value="">타입 선택</option>
                    {{#sectionTypes}}
                        <option value="{{name}}">{{title}}</option>
                    {{/sectionTypes}}
                </select>
            </div>
            <div class="form-group">
                <label for="totalCapacity">최대 수용량:</label>
                <input type="number" id="totalCapacity" name="totalCapacity" value="{{sectionCreateRequestDTO.totalCapacity}}" required>
            </div>
            <button type="submit">구역 등록</button>
        </form>
        {{#sectionCreateError}}
            {{sectionCreateError}}
        {{/sectionCreateError}}

        <h2>창고 담당자 배정</h2>
        <form action="/warehouse/assign" method="post">
            <div class="form-group">
                <label for="assignWarehouseId">대상 창고:</label>
                <select id="assignWarehouseId" name="warehouseId" required>
                    <option value="">창고 선택</option>
                    {{#warehouses}}
                        <option value="{{id}}">{{name}}</option>
                    {{/warehouses}}
                </select>
            </div>
            <div class="form-group">
                <label for="assignUserId">담당할 직원 (일반 회원):</label>
                <select id="assignUserId" name="userId" required>
                    <option value="">직원 선택</option>
                    {{#users}}
                        <option value="{{id}}">{{name}} ({{loginId}})</option>
                    {{/users}}
                </select>
            </div>
            <div class="form-group">
                <label for="managementType">권한:</label>
                <select id="managementType" name="managementType" required>
                    <option value="">권한 선택</option>
                    {{#managementTypes}}
                        <option value="{{name}}">{{roleName}}</option>
                    {{/managementTypes}}
                </select>
            </div>
            <button type="submit">담당자 배정</button>
        </form>
        {{#warehouseAssignmentError}}
            {{warehouseAssignmentError}}
        {{/warehouseAssignmentError}}
    </div>
</div>

<!-- 다음 우편번호 서비스 스크립트 -->
<script src="//t1.daumcdn.net/mapjsapi/bundle/postcode/prod/postcode.v2.js"></script>
<script>
    function openDaumPostcode() {
        new daum.Postcode({
            oncomplete: function(data) {
                let addr = '';
                if (data.userSelectedType === 'R') {
                    addr = data.roadAddress;
                } else {
                    addr = data.jibunAddress;
                }
                document.querySelector('input[name="postcode"]').value = data.zonecode;
                document.querySelector('input[name="address"]').value = addr;
                document.querySelector('input[name="detailAddress"]').focus();
            }
        }).open();
    }
</script>

</body>
</html>
